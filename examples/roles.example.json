{
  "admin": {
    "headers": { "Authorization": "Bearer REPLACE_WITH_ADMIN_TOKEN" },
    "privilege": 10
  },
  "alice": {
    "headers": { "Authorization": "Bearer REPLACE_WITH_ALICE_TOKEN" },
    "owns": { "paste": ["1", "2"] },
    "privilege": 1,
    "refresh": {
      "script": "./examples/get_token.py",
      "dependencies": ["requests"],
      "inject": { "header": "Authorization", "template": "Bearer {token}" }
    }
  },
  "bob": {
    "cookies": { "session": "REPLACE_WITH_BOB_SESSION" },
    "owns": { "paste": ["3"] },
    "privilege": 1
  }
}
